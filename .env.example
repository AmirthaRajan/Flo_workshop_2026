# Choose ollama or openai independently for each RAG stage.
MODEL_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=<your-llm-model>
OLLAMA_EMBEDDING_MODEL=<your-embedding-model>

# Only needed when either provider is openai.
OPENAI_API_KEY=<your-key>
OPENAI_LLM_MODEL=<your-llm-model>
OPENAI_EMBEDDING_MODEL=<your-embedding-model>

TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100
VECTOR_STORE_PATH=data/vector_store

# Opt in only when intentionally loading a trusted internal wiki.
ALLOW_PRIVATE_URLS=false
